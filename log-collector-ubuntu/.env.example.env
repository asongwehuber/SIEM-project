# SIEM Agent
SIEM_AGENT_URL=http://192.168.56.1:6000

# Shared HMAC secret
# Replace this with the same secret configured on the SIEM Agent.
SECRET_KEY=your_shared_secret_here

# Unique identifier for this collector
COLLECTOR_ID=ubuntu-1

# How often to check for new log entries (seconds)
POLL_INTERVAL=1

# Linux authentication log
AUTH_LOG=/var/log/auth.log

# Linux system log
SYSLOG=/var/log/syslog

# Persistent collector state
STATE_FILE=state.json