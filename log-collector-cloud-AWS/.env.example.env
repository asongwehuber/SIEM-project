# ==========================================
# AWS CLOUDTRAIL COLLECTOR
# ==========================================

# AWS region where CloudTrail events are queried
AWS_REGION=us-east-1

# AWS CLI / boto3 profile
AWS_PROFILE=siem-cloud-collector


# ==========================================
# COLLECTOR CONFIGURATION
# ==========================================

# Unique identifier for this collector
COLLECTOR_ID=aws-cloudtrail-1

# Polling interval in seconds
POLL_INTERVAL=30

# Persistent state/checkpoint file
STATE_FILE=state.json


# ==========================================
# SIEM AGENT
# ==========================================

# SIEM Agent address
SIEM_AGENT_URL=http://192.168.1.162:6000


# ==========================================
# SECURITY
# ==========================================

# Shared HMAC-SHA256 secret.
# This MUST match the SECRET_KEY configured
# in the SIEM Agent.
SECRET_KEY=CHANGE_ME_TO_A_STRONG_SHARED_SECRET